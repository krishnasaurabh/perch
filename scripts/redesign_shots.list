# name app arguments. Quoting and trailing comments follow shell word rules.
# Each state runs in light/dark and normal/Reduce Motion, in four app sessions.
# Screen lanes append targets and fixtures here as their presentations land.
welcome --scenario empty --open welcome
today-empty --scenario empty --open today
today-three --scenario three --open today
today-timer --scenario timer --open today
week-three --scenario three --open week
week-timer --scenario timer --open week
today-running --scenario today-running --open today
today-before --scenario today-before --open today
# today-editing is available to the inline-editor target when that screen lands.
today-fresh --scenario today-empty --open today
week-full --scenario week-full --open week
your-week --scenario window-review --open your-week
history --scenario window-history --open history
projects --scenario window-projects --open projects
system --scenario empty --open gallery
motion --scenario timer --open gallery
surfaces --scenario empty --open surfaces
surfaces-focused --scenario empty --open surfaces-focused
keys --scenario empty --open keys
notch-closed-idle --scenario notch-idle --open notch-closed
notch-closed-running --scenario notch-running --open notch-closed
notch-closed-paused --scenario notch-paused --open notch-closed
notch-closed-reminder --scenario notch-reminder --open notch-closed
notch-closed-progress-off --scenario notch-running --open notch-progress-off
notch-closed-reminder-off --scenario notch-reminder --open notch-reminder-off
notch-flat-idle --scenario notch-idle --open notch-flat
notch-flat-running --scenario notch-running --open notch-flat
notch-flat-paused --scenario notch-paused --open notch-flat
notch-flat-reminder --scenario notch-reminder --open notch-flat
settings-general --scenario empty --open settings/general
settings-notch --scenario empty --open settings/notch
settings-notch-configured --scenario empty --open settings/notch-configured
settings-calendar --scenario empty --open settings/calendar
settings-agents --scenario empty --open settings/agents
settings-data --scenario empty --open settings/data
workspace-band-today --scenario today-running --open workspace-today
workspace-band-week --scenario week-full --open workspace-week
workspace-width-960 --scenario today-before --open workspace-today
workspace-width-1280 --scenario week-full --open workspace-week
workspace-week-narrow --scenario week-full --open workspace-narrow
checklist-folded --scenario today-running --open today
checklist-all --scenario today-running --open checklist-expanded
checklist-steps --scenario today-running --open checklist-steps
checklist-selected --scenario today-running --open checklist-selected
checklist-step-entry --scenario three --open checklist-step-entry
checklist-completed --scenario today-running --open checklist-completed
checklist-draft --scenario today-before --open today
checklist-paused --scenario notch-paused --open today
checklist-dictating --scenario three --open checklist-dictating
checklist-voice-error --scenario three --open checklist-voice-error
checklist-multiline --scenario three --open checklist-multiline
